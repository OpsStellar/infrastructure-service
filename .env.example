# Service Configuration
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infrastructure_db

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300

# Service URLs
AUTH_SERVICE_URL=http://auth-service:8001
SETTINGS_SERVICE_URL=http://settings-service:8020
COST_SERVICE_URL=http://cost-service:8010

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# IaC Provider Configuration
ENABLE_TERRAFORM=true
ENABLE_CLOUDFORMATION=true
ENABLE_ARM=true
ENABLE_GCP_DEPLOYMENT=true

# AWS Configuration (optional - can be fetched from settings-service)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure Configuration (optional - can be fetched from settings-service)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GCP Configuration (optional - can be fetched from settings-service)
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# Drift Detection
DRIFT_CHECK_INTERVAL_HOURS=24

# Resource Sync
RESOURCE_SYNC_INTERVAL_MINUTES=30
